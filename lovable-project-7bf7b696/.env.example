# -----------------------------------------------------------------------------
# Al-Arab Shawarma — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file. All values below are empty placeholders.
# Read every sensitive value ONLY from environment variables at runtime.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL + Storage)
# -----------------------------------------------------------------------------

# Prisma connects to Supabase Postgres.
# Use the DIRECT connection string (port 5432), NOT the pooler (port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Public Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Public anon key — safe to expose to the browser, but kept in env for parity.
# Used only by client-safe code paths.
SUPABASE_ANON_KEY=

# SECRET — server-only. Used by the admin server functions for privileged
# operations (Storage uploads). Never ship this to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Better Auth (admin dashboard authentication)
# -----------------------------------------------------------------------------

# SECRET — long random string used to sign auth tokens.
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the running app, e.g. http://localhost:3000 in dev
# or https://your-app.vercel.app in production.
BETTER_AUTH_URL=

# -----------------------------------------------------------------------------
# Public site origin (SEO)
# -----------------------------------------------------------------------------

# Canonical origin of the PUBLIC site (scheme + host, no trailing slash),
# e.g. https://al-arbalshawarma.com.
#
# VITE_SITE_URL is inlined at build time on BOTH the server and the client, so
# the absolute canonical / og:url / JSON-LD url that head() renders is
# identical during SSR and hydration. Set this to the production domain.
# SITE_URL is a server-only fallback (also used by /robots.txt and
# /sitemap.xml when VITE_SITE_URL is unset).
VITE_SITE_URL=
SITE_URL=

# -----------------------------------------------------------------------------
# Seed (prisma/seed.ts) — NOT read at runtime.
# -----------------------------------------------------------------------------

# SECRET — password used ONLY when seeding the admin user (prisma/seed.ts).
# The seed refuses to run without it and never stores it in plaintext.
# Example (PowerShell):  $env:ADMIN_PASSWORD="<strong-password>"; npx prisma db seed
ADMIN_PASSWORD=
